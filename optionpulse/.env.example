# ---------------------------------------------------------------------------
# OptionPulse environment configuration
# Copy to `.env` (git-ignored). NEVER put provider secrets in VITE_* variables:
# anything prefixed with VITE_ is inlined into the browser bundle.
# ---------------------------------------------------------------------------

# ---- Frontend (safe, public) ----
# mock | delayed | live  -- controls the data-mode badge and provider selection
VITE_DATA_MODE=mock
# Leave empty to use the in-browser mock provider (no backend required).
# Set to e.g. /api to talk to the Node backend.
VITE_API_BASE_URL=

# ---- Backend (server-side only, never shipped to the browser) ----
PORT=4000
# mock | live
MARKET_DATA_MODE=mock
# Credentials for a licensed market-data vendor go here, server-side only.
MARKET_DATA_PROVIDER=mock
MARKET_DATA_API_KEY=
MARKET_DATA_API_SECRET=
