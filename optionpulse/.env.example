# ---------------------------------------------------------------------------
# OptionPulse environment configuration
# Copy to `.env` (git-ignored). NEVER put provider secrets in VITE_* variables:
# anything prefixed with VITE_ is inlined into the browser bundle.
# ---------------------------------------------------------------------------

# ---- Frontend (safe, public) ----
# mock | delayed | live. This only labels the UI before data loads; once data
# arrives, the badge shows the provenance the payload itself reports.
VITE_DATA_MODE=mock
# Leave empty to use the in-browser mock provider (no backend required).
# Set to /api to talk to the Node backend, which is where real data comes from.
VITE_API_BASE_URL=

# ---- Backend ----
PORT=4000
CORS_ORIGINS=http://localhost:5180

# mock | angelone
MARKET_DATA_PROVIDER=mock
# live | delayed  (how data from a real provider should be labelled)
MARKET_DATA_MODE=live

# ---- Angel One SmartAPI (server-side only, never sent to the browser) ----
# Create an app at https://smartapi.angelone.in to get the API key, then enable
# TOTP on the account and keep the base32 secret it shows you.
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
# Account MPIN (SmartAPI's login uses the MPIN, not the web password).
ANGELONE_MPIN=
# Base32 TOTP secret from the Angel One two-factor setup screen.
ANGELONE_TOTP_SECRET=

# Where the filtered instrument master is cached between restarts.
ANGELONE_INSTRUMENT_CACHE=.cache/angelone-instruments.json
# SmartAPI requires these headers to be present; values are informational only.
# ANGELONE_LOCAL_IP=
# ANGELONE_PUBLIC_IP=
# ANGELONE_MAC=
