# Base URL of the backend API (include /api)
NEXT_PUBLIC_API_URL=https://api.clothinary.cloudpunch.in/api

# Public site URL (used for SEO metadata, canonical, sitemap).
# MUST be your real domain in production or sitemap/canonical URLs point at localhost.
NEXT_PUBLIC_SITE_URL=https://clothinary.cloudpunch.in

# Admin panel URL (shown in the account menu for admin users)
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Razorpay public key id (test)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
