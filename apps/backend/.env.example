# ---- Server ----
NODE_ENV=development
PORT=5000

# Comma-separated list of allowed frontend origins (scheme + host, no path).
# Local dev origins (localhost/127.0.0.1 on :3000 and :3001) are always allowed
# unless NODE_ENV=production, where ONLY this list is honoured.
# Production example:
#   CORS_ORIGINS=https://clothinary.cloudpunch.in,https://admin.clothinary.cloudpunch.in
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/novastyle

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Razorpay (test keys) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- AI Shopping Assistant (optional) ----
# Without a key, the assistant runs on the built-in rules engine (product
# search, orders, offers, FAQs). With a key it adds natural-language replies
# and multilingual responses via Claude. Model is configurable in the admin.
ANTHROPIC_API_KEY=
