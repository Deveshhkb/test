{
  "name": "clothinary-commerce",
  "version": "1.0.0",
  "private": true,
  "description": "Clothinary — a production-ready fashion e-commerce platform (storefront, API, and admin).",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:backend": "npm --workspace apps/backend run dev",
    "dev:frontend": "npm --workspace apps/frontend run dev",
    "dev:admin": "npm --workspace apps/admin run dev",
    "dev": "concurrently -k -n backend,frontend,admin -c green,cyan,magenta \"npm:dev:backend\" \"npm:dev:frontend\" \"npm:dev:admin\"",
    "seed": "npm --workspace apps/backend run seed",
    "build": "npm --workspace apps/frontend run build && npm --workspace apps/admin run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "gsap": "^3.13.0"
  }
}
