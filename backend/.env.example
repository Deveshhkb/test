# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- Database ----
MONGO_URI=mongodb://127.0.0.1:27017/ayodhya_tirtham

# ---- Auth ----
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ---- CORS (comma-separated list of allowed frontend origins) ----
# Production frontend domain + localhost for development:
CLIENT_URL=https://ayodhyatour.cloudpunch.in,http://localhost:3000

# ---- Public URL of THIS backend (used to build uploaded image links) ----
# Production: https://api.ayodhyatour.cloudpunch.in   Dev: http://localhost:5000
SERVER_URL=http://localhost:5000

# ---- Email notifications (enquiry forms) ----
# For Gmail: create an App Password (Google Account > Security > App passwords)
# and use it as SMTP_PASS. Do NOT use your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=deveshsingh3420@gmail.com
SMTP_PASS=your_gmail_app_password
MAIL_FROM=Ayodhya Tirtham <deveshsingh3420@gmail.com>
# Inbox that receives enquiry notifications:
NOTIFY_EMAIL=deveshsingh3420@gmail.com

# ---- Seed admin (used by the database seeder) ----
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@ayodhyatirtham.com
ADMIN_PASSWORD=Admin@12345
