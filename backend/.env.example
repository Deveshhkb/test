# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGINS=http://localhost:5173,http://localhost:8081

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/savora

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Firebase Admin (service account) — either a path or inline JSON
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Payments
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# Google Maps (server-side Directions / Distance Matrix)
GOOGLE_MAPS_API_KEY=AIzaXXXX
