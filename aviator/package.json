{
  "name": "aviator",
  "private": true,
  "version": "0.1.0",
  "description": "Production-grade AAA Aviator (Crash) game — PixiJS v8 + React 19 client, Node.js authoritative server.",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.5.3"
  }
}
