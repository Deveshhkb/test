{
  "name": "@hkb/baccarat-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Production Baccarat game engine built on PixiJS v8, TypeScript and GSAP. Framework agnostic, embeddable in React.",
  "main": "./dist/baccarat-engine.js",
  "module": "./dist/baccarat-engine.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/baccarat-engine.js"
    },
    "./react": {
      "types": "./src/react/BaccaratGameView.tsx",
      "default": "./src/react/BaccaratGameView.tsx"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "npm run typecheck && vitest run && vite build",
    "build:lib": "npm run typecheck && vite build --mode lib",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "pixi.js": "^8.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "eslint": "^9.21.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.25.0",
    "vite": "^6.2.0",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
