{
  "name": "@casino/roulette-engine",
  "version": "1.0.0",
  "description": "Production-grade HTML5 European/American Roulette engine built on PixiJS v8, TypeScript and GSAP. Framework independent - runs standalone or mounts into any host application.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "main": "./dist/roulette-engine.umd.cjs",
  "module": "./dist/roulette-engine.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/roulette-engine.js",
      "require": "./dist/roulette-engine.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lib": "tsc --noEmit && vite build --config vite.lib.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "lint:types": "tsc --noEmit"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "pixi.js": "^8.19.0"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "typescript": "~5.7.3",
    "vite": "^6.2.0",
    "vite-plugin-dts": "^4.5.0"
  }
}
